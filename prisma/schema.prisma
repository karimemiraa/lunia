generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id        String   @id @default(cuid())
  name      String
  city      String   @default("Riyadh")
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

// Superadmin-managed platform credentials (SMTP, WhatsApp, payment gateway,
// AI, and custom API keys). Kept out of SiteSetting so secrets are never
// returned to the client — the superadmin UI only ever shows a masked hint
// and whether a value is set. Managed via src/modules/platform/secrets.ts.
model PlatformSecret {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

// Editable CRM pipeline stage. Seeded with a simple treatment-center journey
// (New enquiry -> Contacted -> Consultation booked -> Active client, plus
// Lost) and fully editable in the Superadmin panel (add/rename/reorder/
// recolor/delete). ClientProfile.stage stores the stage's `key`. `kind` marks
// whether a stage means still-open, won, or lost — used by reporting,
// notifications, and digests instead of hardcoded stage names.
model PipelineStage {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  sortOrder Int      @default(0)
  kind      String   @default("open") // open | won | lost
  color     String   @default("#9ed5d0")
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

// Whether the lead came to us (inbound) or we reached out (outbound).
enum LeadDirection {
  INBOUND
  OUTBOUND
}

// A WhatsApp conversation with a lead/customer (one per phone number). Inbound
// messages arrive via a provider webhook (pluggable) and outbound replies are
// sent through the same adapter; both are stored here so the whole thread is
// answerable from the System.
model WhatsappConversation {
  id                 String            @id @default(cuid())
  phone              String            @unique
  clientProfileId    String?
  client             ClientProfile?    @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  // Staff member this conversation is assigned to (soft ref, no FK, so a
  // deactivated user doesn't block the thread). Null = unassigned.
  ownerId            String?
  lastMessageAt      DateTime          @default(now())
  lastMessagePreview String?
  unread             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  messages           WhatsappMessage[]

  @@index([lastMessageAt])
}

model WhatsappMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // IN | OUT
  body           String               @db.Text
  authorUserId   String? // staff who sent an OUT message
  providerRef    String?
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

// A logged outreach touch or pipeline event on a lead/customer.
model LeadActivity {
  id              String        @id @default(cuid())
  clientProfileId String
  client          ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  authorUserId    String
  kind            String // CALL | WHATSAPP | EMAIL | SMS | NOTE | STAGE_CHANGE | ASSIGN
  outcome         String? // e.g. NO_ANSWER | INTERESTED | NOT_INTERESTED | BOOKED
  body            String?       @db.Text
  createdAt       DateTime      @default(now())

  @@index([clientProfileId])
}

enum UserType {
  STAFF
  CLIENT
}

model User {
  id                String             @id @default(cuid())
  type              UserType
  email             String?            @unique
  phone             String?            @unique
  passwordHash      String?
  locale            String             @default("en")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  roles             UserRole[]
  staffProfile      StaffProfile?
  clientProfile     ClientProfile?
  staffSchedules    StaffSchedule[]
  employeeRecord    EmployeeRecord?
  attendance        AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  payslips          Payslip[]
  staffAppointments Appointment[]      @relation("StaffAppointments")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  isSystem    Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model StaffProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  title    String?
  bio      String?
}

model MembershipTier {
  id          String             @id @default(cuid())
  key         String             @unique
  name        String
  priority    Int                @default(0)
  discountPct Int                @default(0)
  // Loyalty-points threshold for automatic tier assignment (applyAutoTier in
  // src/modules/crm/loyalty.ts): a client is auto-upgraded to the highest
  // tier whose minPoints is <= their points balance. Defaults to 0, which
  // would make every tier "reachable" at zero points -- see the seed data
  // (prisma/seed.ts) for the deliberate thresholds that keep this sane
  // (guest=0, member/vip staged, and non-loyalty program tiers like
  // bride/postsurgery set unreachably high so they stay staff-assigned-only).
  minPoints   Int                @default(0)
  isSystem    Boolean            @default(false)
  memberships ClientMembership[]
}

model ClientProfile {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName               String
  sourceChannel          String?
  ltvCacheMinor          Int                     @default(0)
  createdAt              DateTime                @default(now())
  // CRM segmentation + clinical (skin center) profile
  tags                   String[]                @default([])
  skinType               String?
  skinConcerns           String[]                @default([])
  allergies              String?
  clinicalNotes          String?
  // Consent (PDPL): timestamps record when consent was last given (null = not given)
  consentTreatmentAt     DateTime?
  consentDataAt          DateTime?
  // Outbound / sales CRM: pipeline stage, assigned owner (soft ref to a staff
  // User, like authorUserId), inbound/outbound classification for channel
  // reporting, and the next follow-up date for non-responders.
  stage                  String                  @default("new")
  ownerId                String?
  direction              LeadDirection?
  nextFollowUpAt         DateTime?
  leadActivities         LeadActivity[]
  whatsappConversations  WhatsappConversation[]
  membership             ClientMembership?
  bookings               Booking[]
  visitNotes             VisitNote[]
  notificationPreference NotificationPreference?
  loyaltyAccount         LoyaltyAccount?
  loyaltyTransactions    LoyaltyTransaction[]
  giftCards              GiftCard[]
  packagePurchases       PackagePurchase[]
  waitlistEntries        WaitlistEntry[]
  medicalIntakes         MedicalIntake[]
  consentSignatures      ConsentSignature[]
  treatmentRecords       TreatmentRecord[]
  clinicalPhotos         ClinicalPhoto[]
  chatSessions           ChatSession[]
  callbackRequests       CallbackRequest[]
  invoices               Invoice[]
  reviews                Review[]
}

// A saved client segment: a named filter over the roster for targeted
// marketing / re-engagement (stored as the same filter shape the roster uses).
model Segment {
  id          String   @id @default(cuid())
  name        String
  filter      Json
  createdAt   DateTime @default(now())
  createdById String?
}

// A one-off announcement/campaign message sent to a segment of customers
// (email/WhatsApp/SMS). One row per send, recording the audience, the exact
// content, and delivery counts. Actual delivery goes through the same
// CommsSender pipeline as booking messages (stub in non-production).
model Broadcast {
  id             String   @id @default(cuid())
  channel        String
  locale         String
  subject        String?
  body           String   @db.Text
  // Machine audience key ("all" | "marketing" | "tier:<id>" | "stage:<STAGE>")
  // plus a human label snapshot for the history list.
  audience       String
  audienceLabel  String
  recipientCount Int      @default(0)
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// A website gift-card purchase. Payment runs through a pluggable gateway
// (stub outside production). On successful payment a GiftCard is issued and
// linked here. No card details are ever stored — a real gateway collects
// those on its own hosted page.
model GiftCardOrder {
  id             String   @id @default(cuid())
  amountMinor    Int
  currency       String   @default("SAR")
  purchaserName  String
  purchaserEmail String
  recipientName  String?
  recipientEmail String?
  message        String?  @db.Text
  status         String   @default("PENDING") // PENDING | PAID | FAILED
  giftCardId     String?
  paymentRef     String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model ClientMembership {
  id        String         @id @default(cuid())
  clientId  String         @unique
  tierId    String
  client    ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tier      MembershipTier @relation(fields: [tierId], references: [id])
  startedAt DateTime       @default(now())
}

enum MediaKind {
  IMAGE
  VIDEO
}

model MediaAsset {
  id           String    @id @default(cuid())
  kind         MediaKind
  storageKey   String    @unique
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altEn        String?
  altAr        String?
  focalX       Float     @default(0.5)
  focalY       Float     @default(0.5)
  createdAt    DateTime  @default(now())
  uploadedById String?
}

model PageContent {
  id        String   @id @default(cuid())
  pageKey   String   @unique
  data      Json
  updatedAt DateTime @default(now()) @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameEn      String
  nameAr      String
  taglineEn   String
  taglineAr   String
  descEn      String
  descAr      String
  heroMediaId String?
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Service {
  id              String              @id @default(cuid())
  slug            String              @unique
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  nameEn          String
  nameAr          String
  summaryEn       String
  summaryAr       String
  benefitsEn      Json
  benefitsAr      Json
  heroMediaId     String?
  order           Int                 @default(0)
  isPublished     Boolean             @default(true)
  durationMin     Int                 @default(60)
  priceMinor      Int                 @default(0)
  onlineBookable  Boolean             @default(true)
  inCenterOnly    Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt
  accessRule      ServiceAccessRule?
  appointments    Appointment[]
  packages        ServicePackage[]
  waitlistEntries WaitlistEntry[]
  consumables     ServiceConsumable[]
  reviews         Review[]
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  descEn      String
  descAr      String
  whyChosenEn String
  whyChosenAr String
  logoMediaId String?
  url         String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleEn     String
  titleAr     String
  excerptEn   String
  excerptAr   String
  bodyEn      String    @db.Text
  bodyAr      String    @db.Text
  heroMediaId String?
  authorName  String?
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model ContactInquiry {
  id              String    @id @default(cuid())
  name            String
  phone           String
  email           String?
  message         String    @db.Text
  locale          String
  sourcePage      String?
  handled         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  // Ownership + linkage (CRM): who's handling it, the linked customer, and the
  // emailed reply (so the whole exchange lives on the inquiry).
  assignedToId    String?
  clientProfileId String?
  repliedAt       DateTime?
  replyBody       String?   @db.Text
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingChannel {
  ONLINE
  FRONT_DESK
  WALK_IN
}

enum PayStatus {
  NONE
  PENDING
  PAID
}

enum MsgKind {
  CONFIRMATION
  REMINDER_24H
  POST_VISIT
  WAITLIST_OPEN
  REVIEW_REQUEST
  INVOICE
  CALLBACK_ACK
}

enum MsgStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

// A client's messaging preferences: which channel to reach them on, and which
// non-transactional message kinds they've opted into. Consulted by the outbox
// (per-message routing + opt-out skipping). OTP is transactional and ignores
// the marketing opt-out.
enum CommsChannelPref {
  AUTO
  WHATSAPP
  SMS
  EMAIL
}

model NotificationPreference {
  id              String           @id @default(cuid())
  clientProfileId String           @unique
  clientProfile   ClientProfile    @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  channel         CommsChannelPref @default(AUTO)
  remindersOptIn  Boolean          @default(true)
  postVisitOptIn  Boolean          @default(true)
  marketingOptIn  Boolean          @default(true)
  updatedAt       DateTime         @default(now()) @updatedAt
}

// A client's points wallet (1:1 with ClientProfile). pointsBalance is a
// denormalized running total kept in sync with the LoyaltyTransaction ledger
// by earnForBooking/redeemPoints/adjustPoints (src/modules/crm/loyalty.ts) --
// list/summary views read this directly rather than summing the ledger.
model LoyaltyAccount {
  id              String        @id @default(cuid())
  clientProfileId String        @unique
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  pointsBalance   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
}

// Append-only ledger of every points earn/redeem/manual-adjustment/tier-note.
// `reason` is a plain string (not an enum), following
// CommunicationLog/MessageTemplate's convention, so new reasons don't need a
// schema migration. The (bookingId, reason) unique constraint makes earning
// idempotent per booking: two calls to earnForBooking for the same booking
// only ever insert one reason="EARN" row (Postgres treats each NULL
// bookingId as distinct, so non-booking-tied reasons like "ADJUST"/"TIER"
// are never blocked by this constraint).
model LoyaltyTransaction {
  id              String        @id @default(cuid())
  clientProfileId String
  client          ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  deltaPoints     Int
  reason          String
  bookingId       String?
  createdAt       DateTime      @default(now())

  @@unique([bookingId, reason])
  @@index([clientProfileId, createdAt])
}

// --- Gift cards & prepaid packages (Cluster C) ------------------------------
// Payments stay off: both features record intent/consumption via their own
// ledger rows (GiftCardRedemption/PackageRedemption), referencing a
// bookingId when redeemed at booking time, and never touch
// Booking.discountMinor (that field belongs to loyalty -- see redeemPoints
// in src/modules/crm/loyalty.ts). See src/modules/commerce/giftcards.ts and
// src/modules/commerce/packages.ts for the redemption/consumption logic.

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  VOID
}

// `code` is a random, unguessable token (crypto.randomBytes-derived, never
// Math.random) generated by issueGiftCard -- see giftcards.ts. balanceMinor
// starts equal to initialMinor and only ever decreases (redeemGiftCard),
// flipping status to REDEEMED once it hits zero; VOID is a manual admin
// state (not modeled by consumption logic itself).
model GiftCard {
  id               String               @id @default(cuid())
  code             String               @unique
  initialMinor     Int
  balanceMinor     Int
  currency         String               @default("SAR")
  issuedToClientId String?
  issuedToClient   ClientProfile?       @relation(fields: [issuedToClientId], references: [id], onDelete: SetNull)
  status           GiftCardStatus       @default(ACTIVE)
  expiresAt        DateTime?
  createdAt        DateTime             @default(now())
  redemptions      GiftCardRedemption[]

  @@index([issuedToClientId])
}

// Append-only ledger of every gift-card redemption -- balanceMinor on
// GiftCard is a denormalized running total kept in sync by redeemGiftCard,
// mirroring LoyaltyAccount/LoyaltyTransaction's split above.
model GiftCardRedemption {
  id          String   @id @default(cuid())
  giftCardId  String
  giftCard    GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  amountMinor Int
  bookingId   String?
  createdAt   DateTime @default(now())

  @@index([giftCardId, createdAt])
}

// A prepaid bundle of sessions, purchasable for a fixed service (serviceId
// set) or usable toward any service (serviceId null). isActive controls
// whether it's still offered for new purchases -- existing PackagePurchase
// rows are unaffected by deactivating the package they were bought under.
model ServicePackage {
  id            String            @id @default(cuid())
  nameEn        String
  nameAr        String
  serviceId     String?
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  sessionsTotal Int
  priceMinor    Int
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  purchases     PackagePurchase[]
}

enum PackagePurchaseStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

// One client's purchase of a ServicePackage. sessionsRemaining starts equal
// to the package's sessionsTotal and only ever decreases
// (consumePackageSession), flipping status to EXHAUSTED at zero; EXPIRED is
// reserved for a future time-based expiry policy (not set by any service
// function yet).
model PackagePurchase {
  id                String                @id @default(cuid())
  clientProfileId   String
  clientProfile     ClientProfile         @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  packageId         String
  package           ServicePackage        @relation(fields: [packageId], references: [id])
  sessionsRemaining Int
  status            PackagePurchaseStatus @default(ACTIVE)
  createdAt         DateTime              @default(now())
  redemptions       PackageRedemption[]

  @@index([clientProfileId, status])
}

// Append-only ledger of every package-session consumption, mirroring
// GiftCardRedemption above.
model PackageRedemption {
  id                String          @id @default(cuid())
  packagePurchaseId String
  packagePurchase   PackagePurchase @relation(fields: [packagePurchaseId], references: [id], onDelete: Cascade)
  bookingId         String?
  createdAt         DateTime        @default(now())

  @@index([packagePurchaseId, createdAt])
}

model Room {
  id           String        @id @default(cuid())
  name         String
  capacity     Int           @default(1)
  isActive     Boolean       @default(true)
  order        Int           @default(0)
  appointments Appointment[]
}

// weekday: 0 = Sunday .. 6 = Saturday. startMin/endMin are minutes from
// midnight, center-local time (e.g. 600 = 10:00, 1200 = 20:00).
model StaffSchedule {
  id          String  @id @default(cuid())
  staffUserId String
  staff       User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  weekday     Int
  startMin    Int
  endMin      Int
  isActive    Boolean @default(true)

  @@index([staffUserId, weekday])
}

// Gates a Service behind a minimum MembershipTier. minTierId is a soft
// reference (no hard FK) to MembershipTier.id so tiers can be managed
// independently; null means the service is open to all clients.
model ServiceAccessRule {
  id        String  @id @default(cuid())
  serviceId String  @unique
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  minTierId String?
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONVERTED
  EXPIRED
}

// A client (or walk-up contact) waiting for a slot to open on a given
// service+day. Notify-on-free (cancel()/reschedule() in bookings.ts, via
// notifyWaitlistForSlot in waitlist.ts) schedules a WAITLIST_OPEN message
// for the oldest WAITING entries and flips them to NOTIFIED. clientProfileId
// is set for a signed-in client (their User's phone/email/locale is used to
// notify); name/phone/email/locale are the walk-up fallback used when there
// is no clientProfileId (the public join form and admin walk-up add don't
// require OTP verification the way the booking wizard does).
model WaitlistEntry {
  id              String         @id @default(cuid())
  serviceId       String
  service         Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientProfileId String?
  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  name            String?
  phone           String?
  email           String?
  locale          String         @default("ar")
  /**
   * Center-local "YYYY-MM-DD" the client wants a slot on.
   */
  desiredDateISO  String
  desiredWindow   String?
  status          WaitlistStatus @default(WAITING)
  createdAt       DateTime       @default(now())
  notifiedAt      DateTime?

  @@index([serviceId, desiredDateISO, status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// A client's post-visit review of a completed booking. Row lifecycle:
// 1. complete() (bookings.ts) calls scheduleReviewRequest, which creates this
//    row up-front in status PENDING with a fresh unguessable `token` and NO
//    content yet (rating 0 is the sentinel for "not submitted"; the public
//    submit page is the only thing that ever writes real content), and
//    schedules a REVIEW_REQUEST message containing the tokenized link. This
//    "pre-created" design (rather than creating the row only at submit time)
//    is what lets submitReview enforce single-use purely from this table
//    (token lookup + tokenUsedAt), with no separate token store.
// 2. The client visits /{locale}/review/<token> and submits once
//    (submitReview sets rating/title/body/authorDisplayName/consentPublic +
//    tokenUsedAt, still PENDING -- moderation-required before publish).
// 3. An admin approves or rejects it (approveReview/rejectReview, audited).
// Only APPROVED rows with consentPublic=true ever appear in
// getAggregate/listApprovedReviews (public-facing reads).
model Review {
  id                String         @id @default(cuid())
  clientProfileId   String?
  clientProfile     ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  bookingId         String?        @unique
  booking           Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  serviceId         String?
  service           Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  // 0 until the client submits (see design note above); submitReview
  // validates/writes 1..5.
  rating            Int            @default(0)
  title             String?
  body              String?
  locale            String         @default("ar")
  authorDisplayName String?
  status            ReviewStatus   @default(PENDING)
  // Whether the client consented to their name/quote being shown publicly
  // (Testimonials, JSON-LD Review entities). A review can be APPROVED for
  // internal reputation tracking without ever being public.
  consentPublic     Boolean        @default(false)
  // Unguessable (crypto.randomBytes-derived) single-use token for the public
  // submit link; tokenUsedAt is set the moment submitReview succeeds so a
  // replayed/shared link can never overwrite an already-submitted review.
  token             String         @unique
  tokenUsedAt       DateTime?
  createdAt         DateTime       @default(now())
  approvedAt        DateTime?

  @@index([status])
  @@index([serviceId])
}

model Booking {
  id              String         @id @default(cuid())
  clientProfileId String
  client          ClientProfile  @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  status          BookingStatus  @default(CONFIRMED)
  channel         BookingChannel @default(ONLINE)
  sourceChannel   String?
  notes           String?
  // Two customer-visible note streams (distinct from the internal `notes`
  // above, which stays admin-only):
  //   centerNote   — written by staff FOR the customer (prep/care
  //                  instructions), shown read-only on the customer's
  //                  appointment detail page.
  //   customerNote — written by the customer (requests/context), shown
  //                  read-only to staff in the day view.
  centerNote      String?        @db.Text
  customerNote    String?        @db.Text
  depositStatus   PayStatus      @default(NONE)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  appointments    Appointment[]
  checkIn         CheckIn?
  review          Review?
  // Loyalty-points discount applied at booking time (redeemPoints in
  // src/modules/crm/loyalty.ts), in the same integer minor currency unit as
  // Appointment.priceMinorSnapshot. Payments stay off -- this only records
  // the intended discount for the ledger/earn-basis, never a real charge.
  discountMinor   Int            @default(0)

  @@index([createdAt])
}

model Appointment {
  id                 String   @id @default(cuid())
  bookingId          String
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId          String
  service            Service  @relation(fields: [serviceId], references: [id])
  staffUserId        String
  staff              User     @relation("StaffAppointments", fields: [staffUserId], references: [id])
  roomId             String
  room               Room     @relation(fields: [roomId], references: [id])
  startAt            DateTime
  endAt              DateTime
  priceMinorSnapshot Int      @default(0)

  @@index([staffUserId, startAt])
  @@index([roomId, startAt])
}

model CheckIn {
  id        String    @id @default(cuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  arrivedAt DateTime  @default(now())
  seatedAt  DateTime?
}

model ScheduledMessage {
  id              String    @id @default(cuid())
  bookingId       String?
  kind            MsgKind
  toPhone         String?
  toEmail         String?
  locale          String
  sendAt          DateTime
  sentAt          DateTime?
  status          MsgStatus @default(PENDING)
  payload         Json
  createdAt       DateTime  @default(now())
  // Optional link to the client this message is for, so the outbox can look
  // up their NotificationPreference (channel routing + opt-out skipping).
  clientProfileId String?
  // Set atomically when a worker claims a batch (PENDING -> SENDING); lets
  // multiple worker replicas run without double-sending, and lets an
  // abandoned SENDING row (crashed worker) be reclaimed after a timeout.
  claimId         String?
  claimedAt       DateTime?

  @@index([status, sendAt])
  @@index([claimId])
  @@index([status, claimedAt])
}

// Audit trail of every outbound communication attempt (sent or failed),
// written by processDueMessages alongside the ScheduledMessage status flip.
// channel/kind/status are plain strings (not enums) since Stage 6 may add
// provider-specific channels/kinds without a schema migration.
model CommunicationLog {
  id          String   @id @default(cuid())
  channel     String
  kind        String
  // Exactly one recipient field is set per row, depending on the channel:
  // phone channels (whatsapp/sms) set toPhone; the email channel sets toEmail.
  toPhone     String?
  toEmail     String?
  bookingId   String?
  status      String
  body        String   @db.Text
  providerRef String?
  createdAt   DateTime @default(now())

  @@index([toPhone])
  @@index([toEmail])
  @@index([bookingId])
}

// Free-text clinical/CRM notes attached to a client, optionally tied to the
// booking/visit they were written during. bookingId/authorUserId are kept as
// soft String refs (no hard FK) since notes should survive a booking being
// deleted or a staff user being deactivated — only the client relation
// cascades.
model VisitNote {
  id              String        @id @default(cuid())
  clientProfileId String
  client          ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  bookingId       String?
  authorUserId    String
  body            String        @db.Text
  // Pinned comments surface at the top of the profile and as header flags
  // (e.g. "Allergic to X", "Prefers afternoons") — front-desk critical info.
  pinned          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([clientProfileId])
}

// Monthly ad spend per channel, used to compute CAC alongside sourceChannel
// on ClientProfile/Booking. periodMonth is a "YYYY-MM" string.
model CampaignSpend {
  id          String   @id @default(cuid())
  channel     String
  periodMonth String
  amountMinor Int
  note        String?
  createdAt   DateTime @default(now())

  @@unique([channel, periodMonth])
}

// Registry of bilingual message templates per (kind, locale, channel),
// managed by staff via the admin CMS and consumed by
// src/modules/comms/templates.ts's renderTemplate(). kind/locale/channel are
// plain strings (not enums), matching CommunicationLog's convention, since
// Stage 6 may add new kinds/channels without a schema migration.
model MessageTemplate {
  id                   String   @id @default(cuid())
  kind                 String
  locale               String
  channel              String
  bodyTemplate         String   @db.Text
  providerTemplateName String?
  isActive             Boolean  @default(true)
  updatedAt            DateTime @default(now()) @updatedAt

  @@unique([kind, locale, channel])
}

// One row per page load, written by client-side analytics beaconing.
model PageView {
  id           String   @id @default(cuid())
  path         String
  locale       String?
  referrerHost String?
  source       String?
  sessionId    String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([source])
}

// Generic funnel/interaction events (e.g. "booking_started",
// "booking_completed"), written by client-side analytics beaconing.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  sessionId String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([name])
}

// Append-only audit trail of sensitive admin mutations (role/permission
// changes, tier changes, settings writes, ...). actorUserId is a SOFT
// reference (no FK) so audit rows survive even if the acting staff user is
// later removed -- the trail must outlive the actor.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  summary     String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
}

// ===========================================================================
// Patient file (clinical record). Sensitive: gated by clinical:manage.
// ===========================================================================

// A medical-history questionnaire submission (the customer fills it in their
// account before a first visit, or staff capture it at the desk). Append-only
// so the file keeps its history; the latest row is the current answers.
model MedicalIntake {
  id              String        @id @default(cuid())
  clientProfileId String
  client          ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  /// { conditions: string[], medications, allergies, pregnant, breastfeeding,
  ///   recentProcedures, skinType, concerns: string[], goals, ... }
  answers         Json
  submittedBy     String        @default("CLIENT") // CLIENT | STAFF
  staffUserId     String?
  createdAt       DateTime      @default(now())

  @@index([clientProfileId, createdAt])
}

// A consent-form template (bilingual), optionally tied to specific services.
// Editing bumps `version`; signatures keep the version they agreed to.
model ConsentForm {
  id         String             @id @default(cuid())
  key        String             @unique
  titleEn    String
  titleAr    String
  bodyEn     String             @db.Text
  bodyAr     String             @db.Text
  serviceIds String[]           @default([])
  version    Int                @default(1)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @default(now()) @updatedAt
  signatures ConsentSignature[]
}

model ConsentSignature {
  id              String        @id @default(cuid())
  clientProfileId String
  client          ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  consentFormId   String
  consentForm     ConsentForm   @relation(fields: [consentFormId], references: [id], onDelete: Restrict)
  formVersion     Int
  /// Snapshot of the exact text agreed to (form may change later).
  bodySnapshot    String        @db.Text
  signerName      String
  /// PNG data URL of the drawn signature.
  signatureData   String        @db.Text
  locale          String        @default("ar")
  bookingId       String?
  witnessUserId   String?
  ip              String?
  signedAt        DateTime      @default(now())

  @@index([clientProfileId, signedAt])
}

// What was actually done in a session: settings, products, reaction, next step.
model TreatmentRecord {
  id              String          @id @default(cuid())
  clientProfileId String
  client          ClientProfile   @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  appointmentId   String?         @unique
  serviceId       String?
  performedById   String
  performedAt     DateTime        @default(now())
  /// Free-form device/protocol settings, e.g. { device, wavelength, passes }.
  settings        Json?
  /// [{ productId?, name, qty, unit }]
  productsUsed    Json?
  notes           String?         @db.Text
  skinReaction    String?
  followUpAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  photos          ClinicalPhoto[]

  @@index([clientProfileId, performedAt])
}

// Clinical / skin-analysis photos. PRIVATE: stored under the storage prefix
// "clinical/" and only served through an authenticated admin route — never via
// the public /api/media route.
model ClinicalPhoto {
  id                String           @id @default(cuid())
  clientProfileId   String
  client            ClientProfile    @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  treatmentRecordId String?
  treatmentRecord   TreatmentRecord? @relation(fields: [treatmentRecordId], references: [id], onDelete: SetNull)
  storageKey        String
  mime              String           @default("image/jpeg")
  kind              String           @default("OTHER") // BEFORE | AFTER | ANALYSIS | OTHER
  area              String?
  /// Imaging device that produced it (e.g. skin analyzer), if any.
  device            String?
  note              String?
  consentToShare    Boolean          @default(false)
  uploadedById      String
  takenAt           DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@index([clientProfileId, takenAt])
}

// ===========================================================================
// On-site assistant (rule-based chatbot) + call-back queue.
// ===========================================================================

model ChatSession {
  id                    String            @id @default(cuid())
  /// Opaque token held in the visitor's cookie.
  token                 String            @unique
  locale                String            @default("ar")
  clientProfileId       String?
  client                ClientProfile?    @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  name                  String?
  phone                 String?
  email                 String?
  /// Structured facts the assistant extracted: { concerns[], goals[], skinType,
  /// area, timeline, budget, previousTreatments, contraindications[], ... }
  profile               Json              @default("{}")
  /// [{ from: "bot"|"user", text, at, step? }]
  transcript            Json              @default("[]")
  /// Current step of the conversation state machine.
  state                 String            @default("start")
  outcome               String? // BOOKED | CALLBACK | LEAD | WHATSAPP | ABANDONED
  bookingId             String?
  recommendedServiceIds String[]          @default([])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  callbacks             CallbackRequest[]

  @@index([createdAt])
  @@index([outcome])
}

model CallbackRequest {
  id              String         @id @default(cuid())
  clientProfileId String?
  client          ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  chatSessionId   String?
  chatSession     ChatSession?   @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  name            String
  phone           String
  locale          String         @default("ar")
  /// e.g. "morning" | "afternoon" | "evening" | "asap"
  preferredWindow String?
  topic           String?
  notes           String?        @db.Text
  source          String         @default("CHAT") // CHAT | WEBSITE | WHATSAPP | STAFF
  status          String         @default("OPEN") // OPEN | NO_ANSWER | DONE | CANCELLED
  attempts        Int            @default(0)
  assignedToId    String?
  dueAt           DateTime?
  outcome         String?
  handledById     String?
  handledAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@index([status, dueAt])
}

// ===========================================================================
// Billing & accounting (VAT invoices, payments, expenses, cash drawer).
// Money is in minor units (halalas). VAT default 15%.
// ===========================================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  MADA
  APPLE_PAY
  BANK_TRANSFER
  GIFT_CARD
  PACKAGE
  ONLINE
  OTHER
}

model Invoice {
  id                String         @id @default(cuid())
  /// Human sequential number, e.g. "INV-2026-000123" / "CN-2026-000004".
  number            String         @unique
  kind              String         @default("INVOICE") // INVOICE | CREDIT_NOTE
  originalInvoiceId String?
  clientProfileId   String?
  client            ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  bookingId         String?
  customerName      String
  customerPhone     String?
  customerVatNumber String?
  status            InvoiceStatus  @default(DRAFT)
  issuedAt          DateTime?
  /// Totals after line discounts. subtotal excludes VAT.
  subtotalMinor     Int            @default(0)
  discountMinor     Int            @default(0)
  vatMinor          Int            @default(0)
  totalMinor        Int            @default(0)
  paidMinor         Int            @default(0)
  vatRateBp         Int            @default(1500)
  notes             String?        @db.Text
  createdById       String?
  // ZATCA e-invoicing. Phase 1: QR (TLV base64). Phase 2 fields are filled
  // once the Fatoora onboarding (CSID) is configured.
  zatcaUuid         String?        @unique
  zatcaCounter      Int?
  zatcaQr           String?        @db.Text
  zatcaHash         String?
  zatcaPrevHash     String?
  zatcaStatus       String         @default("NOT_SUBMITTED") // NOT_SUBMITTED | REPORTED | CLEARED | REJECTED
  zatcaXml          String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  lines             InvoiceLine[]
  payments          Payment[]
  paymentLinks      PaymentLink[]

  @@index([clientProfileId])
  @@index([bookingId])
  @@index([issuedAt])
  @@index([status])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind           String  @default("SERVICE") // SERVICE | PRODUCT | PACKAGE | GIFT_CARD | OTHER
  serviceId      String?
  productId      String?
  description    String
  qty            Int     @default(1)
  /// Unit price EXCLUDING VAT.
  unitPriceMinor Int
  discountMinor  Int     @default(0)
  vatRateBp      Int     @default(1500)
  vatMinor       Int     @default(0)
  /// Line total INCLUDING VAT.
  totalMinor     Int     @default(0)
  sortOrder      Int     @default(0)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  method        PaymentMethod
  /// Negative for refunds.
  amountMinor   Int
  reference     String?
  provider      String?
  providerRef   String?
  status        String        @default("COMPLETED") // COMPLETED | FAILED | REFUNDED
  receivedById  String?
  cashSessionId String?
  receivedAt    DateTime      @default(now())
  note          String?

  @@index([invoiceId])
  @@index([receivedAt])
}

// Online "pay by link" (sent over WhatsApp/email). Provider-agnostic; the
// gateway (e.g. Moyasar: mada/Visa/Mastercard/Apple Pay) is configured in
// Superadmin → Payments.
model PaymentLink {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String?
  url         String?
  amountMinor Int
  status      String    @default("PENDING") // PENDING | PAID | EXPIRED | FAILED
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([providerRef])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id            String           @id @default(cuid())
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor        String?
  description   String
  /// Amount EXCLUDING VAT.
  amountMinor   Int
  vatMinor      Int              @default(0)
  paidAt        DateTime         @default(now())
  method        PaymentMethod    @default(BANK_TRANSFER)
  reference     String?
  attachmentKey String?
  createdById   String?
  createdAt     DateTime         @default(now())

  @@index([paidAt])
}

// A front-desk cash drawer session (open with a float, close with a count).
model CashSession {
  id                String    @id @default(cuid())
  openedById        String
  openedAt          DateTime  @default(now())
  openingFloatMinor Int       @default(0)
  closedById        String?
  closedAt          DateTime?
  countedCashMinor  Int?
  expectedCashMinor Int?
  note              String?

  @@index([openedAt])
}

// ===========================================================================
// Inventory (retail products + treatment consumables).
// Quantities are integers in the product's base unit (pcs, ml, g).
// ===========================================================================

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  vatNumber      String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model Product {
  id           String              @id @default(cuid())
  sku          String?             @unique
  barcode      String?             @unique
  nameEn       String
  nameAr       String?
  brandName    String?
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category     String?
  unit         String              @default("pcs")
  kind         String              @default("RETAIL") // RETAIL | CONSUMABLE | BOTH
  costMinor    Int                 @default(0)
  /// Retail price EXCLUDING VAT.
  priceMinor   Int                 @default(0)
  vatRateBp    Int                 @default(1500)
  reorderLevel Int                 @default(0)
  /// Denormalized running balance of StockMovement.qty.
  stockQty     Int                 @default(0)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  movements    StockMovement[]
  consumables  ServiceConsumable[]
  poLines      PurchaseOrderLine[]
}

model StockMovement {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Positive = stock in, negative = stock out.
  qty           Int
  type          String // PURCHASE | SALE | CONSUMPTION | ADJUSTMENT | RETURN | WASTE
  refType       String? // INVOICE | APPOINTMENT | PURCHASE_ORDER | MANUAL
  refId         String?
  unitCostMinor Int?
  lotNumber     String?
  expiresAt     DateTime?
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([productId, createdAt])
  @@index([refType, refId])
}

// Bill of materials: what a service consumes from stock each time it is done.
model ServiceConsumable {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int

  @@unique([serviceId, productId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status      String              @default("DRAFT") // DRAFT | ORDERED | PARTIAL | RECEIVED | CANCELLED
  orderedAt   DateTime?
  receivedAt  DateTime?
  totalMinor  Int                 @default(0)
  notes       String?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  lines       PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty             Int
  unitCostMinor   Int
  receivedQty     Int           @default(0)
}

// ===========================================================================
// HR & payroll.
// ===========================================================================

model EmployeeRecord {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNo              String?   @unique
  nationality             String?
  isSaudi                 Boolean   @default(false)
  nationalId              String?
  nationalIdExpiry        DateTime?
  passportNo              String?
  passportExpiry          DateTime?
  jobTitle                String?
  department              String?
  hireDate                DateTime?
  contractType            String? // FULL_TIME | PART_TIME | CONTRACTOR
  contractEnd             DateTime?
  basicSalaryMinor        Int       @default(0)
  housingAllowanceMinor   Int       @default(0)
  transportAllowanceMinor Int       @default(0)
  otherAllowanceMinor     Int       @default(0)
  /// Commission on completed-service revenue, in basis points (500 = 5%).
  commissionBp            Int       @default(0)
  gosiApplicable          Boolean   @default(true)
  iban                    String?
  bankName                String?
  annualLeaveDays         Int       @default(21)
  emergencyContact        String?
  notes                   String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt
}

model AttendanceRecord {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Center-local "YYYY-MM-DD".
  dateISO    String
  clockInAt  DateTime
  clockOutAt DateTime?
  source     String    @default("SELF") // SELF | MANUAL
  note       String?
  editedById String?

  @@index([userId, dateISO])
  @@index([dateISO])
}

model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String    @default("ANNUAL") // ANNUAL | SICK | UNPAID | OTHER
  startDateISO String
  endDateISO   String
  days         Int
  reason       String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
}

model PayrollRun {
  id            String    @id @default(cuid())
  /// "YYYY-MM"
  periodMonth   String    @unique
  status        String    @default("DRAFT") // DRAFT | APPROVED | PAID
  totalNetMinor Int       @default(0)
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  payslips      Payslip[]
}

model Payslip {
  id                String     @id @default(cuid())
  payrollRunId      String
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  basicMinor        Int        @default(0)
  housingMinor      Int        @default(0)
  transportMinor    Int        @default(0)
  otherAllowMinor   Int        @default(0)
  commissionMinor   Int        @default(0)
  overtimeMinor     Int        @default(0)
  bonusMinor        Int        @default(0)
  deductionsMinor   Int        @default(0)
  gosiEmployeeMinor Int        @default(0)
  gosiEmployerMinor Int        @default(0)
  netMinor          Int        @default(0)
  notes             String?

  @@unique([payrollRunId, userId])
}
