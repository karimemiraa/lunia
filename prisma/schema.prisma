generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id        String   @id @default(cuid())
  name      String
  city      String   @default("Riyadh")
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

enum UserType {
  STAFF
  CLIENT
}

model User {
  id                 String          @id @default(cuid())
  type               UserType
  email              String?         @unique
  phone              String?         @unique
  passwordHash       String?
  locale             String          @default("en")
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  roles              UserRole[]
  staffProfile       StaffProfile?
  clientProfile      ClientProfile?
  staffSchedules     StaffSchedule[]
  staffAppointments  Appointment[]   @relation("StaffAppointments")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  isSystem    Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model StaffProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  title    String?
  bio      String?
}

model MembershipTier {
  id          String             @id @default(cuid())
  key         String             @unique
  name        String
  priority    Int                @default(0)
  discountPct Int                @default(0)
  isSystem    Boolean            @default(false)
  memberships ClientMembership[]
}

model ClientProfile {
  id            String            @id @default(cuid())
  userId        String            @unique
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  sourceChannel String?
  ltvCacheMinor Int               @default(0)
  createdAt     DateTime          @default(now())
  membership    ClientMembership?
  bookings      Booking[]
  visitNotes    VisitNote[]
}

model ClientMembership {
  id        String         @id @default(cuid())
  clientId  String         @unique
  tierId    String
  client    ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tier      MembershipTier @relation(fields: [tierId], references: [id])
  startedAt DateTime       @default(now())
}

enum MediaKind {
  IMAGE
  VIDEO
}

model MediaAsset {
  id           String    @id @default(cuid())
  kind         MediaKind
  storageKey   String    @unique
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altEn        String?
  altAr        String?
  focalX       Float     @default(0.5)
  focalY       Float     @default(0.5)
  createdAt    DateTime  @default(now())
  uploadedById String?
}

model PageContent {
  id        String   @id @default(cuid())
  pageKey   String   @unique
  data      Json
  updatedAt DateTime @default(now()) @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameEn      String
  nameAr      String
  taglineEn   String
  taglineAr   String
  descEn      String
  descAr      String
  heroMediaId String?
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Service {
  id             String             @id @default(cuid())
  slug           String             @unique
  departmentId   String
  department     Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  nameEn         String
  nameAr         String
  summaryEn      String
  summaryAr      String
  benefitsEn     Json
  benefitsAr     Json
  heroMediaId    String?
  order          Int                @default(0)
  isPublished    Boolean            @default(true)
  durationMin    Int                @default(60)
  priceMinor     Int                @default(0)
  onlineBookable Boolean            @default(true)
  inCenterOnly   Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  accessRule     ServiceAccessRule?
  appointments   Appointment[]
}

model Brand {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  descEn       String
  descAr       String
  whyChosenEn  String
  whyChosenAr  String
  logoMediaId  String?
  url          String?
  order        Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleEn     String
  titleAr     String
  excerptEn   String
  excerptAr   String
  bodyEn      String    @db.Text
  bodyAr      String    @db.Text
  heroMediaId String?
  authorName  String?
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model ContactInquiry {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  message    String   @db.Text
  locale     String
  sourcePage String?
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingChannel {
  ONLINE
  FRONT_DESK
  WALK_IN
}

enum PayStatus {
  NONE
  PENDING
  PAID
}

enum MsgKind {
  CONFIRMATION
  REMINDER_24H
  POST_VISIT
}

enum MsgStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model Room {
  id           String        @id @default(cuid())
  name         String
  capacity     Int           @default(1)
  isActive     Boolean       @default(true)
  order        Int           @default(0)
  appointments Appointment[]
}

// weekday: 0 = Sunday .. 6 = Saturday. startMin/endMin are minutes from
// midnight, center-local time (e.g. 600 = 10:00, 1200 = 20:00).
model StaffSchedule {
  id          String  @id @default(cuid())
  staffUserId String
  staff       User    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  weekday     Int
  startMin    Int
  endMin      Int
  isActive    Boolean @default(true)

  @@index([staffUserId, weekday])
}

// Gates a Service behind a minimum MembershipTier. minTierId is a soft
// reference (no hard FK) to MembershipTier.id so tiers can be managed
// independently; null means the service is open to all clients.
model ServiceAccessRule {
  id        String  @id @default(cuid())
  serviceId String  @unique
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  minTierId String?
}

model Booking {
  id              String         @id @default(cuid())
  clientProfileId String
  client          ClientProfile  @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  status          BookingStatus  @default(CONFIRMED)
  channel         BookingChannel @default(ONLINE)
  sourceChannel   String?
  notes           String?
  depositStatus   PayStatus      @default(NONE)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  appointments    Appointment[]
  checkIn         CheckIn?

  @@index([createdAt])
}

model Appointment {
  id                 String   @id @default(cuid())
  bookingId          String
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId          String
  service            Service  @relation(fields: [serviceId], references: [id])
  staffUserId        String
  staff              User     @relation("StaffAppointments", fields: [staffUserId], references: [id])
  roomId             String
  room               Room     @relation(fields: [roomId], references: [id])
  startAt            DateTime
  endAt              DateTime
  priceMinorSnapshot Int      @default(0)

  @@index([staffUserId, startAt])
  @@index([roomId, startAt])
}

model CheckIn {
  id        String    @id @default(cuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  arrivedAt DateTime  @default(now())
  seatedAt  DateTime?
}

model ScheduledMessage {
  id        String    @id @default(cuid())
  bookingId String?
  kind      MsgKind
  toPhone   String
  locale    String
  sendAt    DateTime
  sentAt    DateTime?
  status    MsgStatus @default(PENDING)
  payload   Json
  createdAt DateTime  @default(now())
  // Set atomically when a worker claims a batch (PENDING -> SENDING); lets
  // multiple worker replicas run without double-sending, and lets an
  // abandoned SENDING row (crashed worker) be reclaimed after a timeout.
  claimId   String?
  claimedAt DateTime?

  @@index([status, sendAt])
  @@index([claimId])
  @@index([status, claimedAt])
}

// Audit trail of every outbound communication attempt (sent or failed),
// written by processDueMessages alongside the ScheduledMessage status flip.
// channel/kind/status are plain strings (not enums) since Stage 6 may add
// provider-specific channels/kinds without a schema migration.
model CommunicationLog {
  id          String   @id @default(cuid())
  channel     String
  kind        String
  toPhone     String
  bookingId   String?
  status      String
  body        String   @db.Text
  providerRef String?
  createdAt   DateTime @default(now())

  @@index([toPhone])
  @@index([bookingId])
}

// Free-text clinical/CRM notes attached to a client, optionally tied to the
// booking/visit they were written during. bookingId/authorUserId are kept as
// soft String refs (no hard FK) since notes should survive a booking being
// deleted or a staff user being deactivated — only the client relation
// cascades.
model VisitNote {
  id              String        @id @default(cuid())
  clientProfileId String
  client          ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  bookingId       String?
  authorUserId    String
  body            String        @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([clientProfileId])
}

// Monthly ad spend per channel, used to compute CAC alongside sourceChannel
// on ClientProfile/Booking. periodMonth is a "YYYY-MM" string.
model CampaignSpend {
  id          String   @id @default(cuid())
  channel     String
  periodMonth String
  amountMinor Int
  note        String?
  createdAt   DateTime @default(now())

  @@unique([channel, periodMonth])
}

// Registry of bilingual message templates per (kind, locale, channel),
// managed by staff via the admin CMS and consumed by
// src/modules/comms/templates.ts's renderTemplate(). kind/locale/channel are
// plain strings (not enums), matching CommunicationLog's convention, since
// Stage 6 may add new kinds/channels without a schema migration.
model MessageTemplate {
  id                   String   @id @default(cuid())
  kind                 String
  locale               String
  channel              String
  bodyTemplate         String   @db.Text
  providerTemplateName String?
  isActive             Boolean  @default(true)
  updatedAt            DateTime @default(now()) @updatedAt

  @@unique([kind, locale, channel])
}

// One row per page load, written by client-side analytics beaconing.
model PageView {
  id           String   @id @default(cuid())
  path         String
  locale       String?
  referrerHost String?
  source       String?
  sessionId    String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([source])
}

// Generic funnel/interaction events (e.g. "booking_started",
// "booking_completed"), written by client-side analytics beaconing.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  sessionId String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([name])
}
