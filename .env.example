DATABASE_URL="postgresql://lunia:lunia_local@localhost:5432/lunia?schema=public"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="change-me-to-a-32-plus-char-random-string"
APP_URL="http://localhost:3000"
NODE_ENV="development"
SEED_OWNER_EMAIL="owner@lunia.local"
SEED_OWNER_PASSWORD="ChangeMe123!"

# Communications (Stage 6) — optional. Real WhatsApp/SMS sending requires
# client-provided provider credentials + (WhatsApp) pre-approved message
# templates. Leave COMMS_PROVIDER=none for local dev (messages are logged,
# not sent).
COMMS_PROVIDER="none"
# COMMS_FROM="+15550001111"
# Channel booking messages are sent on: "whatsapp" or "sms". Leave unset to
# derive it from the provider (unifonic->sms, meta/twilio->whatsapp). Set to
# "sms" for a Twilio account provisioned for SMS rather than WhatsApp.
# COMMS_BOOKING_CHANNEL="whatsapp"
#
# Meta WhatsApp Cloud API (COMMS_PROVIDER="meta_whatsapp")
# META_WA_TOKEN="your-meta-whatsapp-access-token"
# META_WA_PHONE_ID="your-meta-whatsapp-phone-number-id"
#
# Twilio (COMMS_PROVIDER="twilio")
# TWILIO_ACCOUNT_SID="your-twilio-account-sid"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_FROM="+15550002222"
#
# Unifonic (COMMS_PROVIDER="unifonic")
# UNIFONIC_APP_SID="your-unifonic-app-sid"
# UNIFONIC_SENDER_ID="your-unifonic-sender-id"
